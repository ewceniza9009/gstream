# ---------------------------------------------------
# --- General & Public-Facing Configuration
# ---------------------------------------------------
# Use your server's domain name or public IP address here
DOMAIN_OR_IP=192.168.1.7

# Public ports exposed on the host machine
PUBLIC_HTTP_PORT=5107
PUBLIC_HTTPS_PORT=5108

# ---------------------------------------------------
# --- Database & Redis Configuration
# ---------------------------------------------------
DB_SERVER=host.docker.internal
DB_NAME=gstream
DB_USER=gstream_user
DB_PASS=gstream_pass
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------
# --- Application & JWT Secrets
# ---------------------------------------------------
# Use a long, random string (32+ characters)
JWT_KEY=REPLACE_WITH_YOUR_32_CHAR_JWT_SECRET_KEY
JWT_ISSUER=gstream-api
JWT_AUDIENCE=gstream-clients

# ---------------------------------------------------
# --- LiveKit Configuration & Secrets
# ---------------------------------------------------
LIVEKIT_API_KEY=APIKeyForGStream
# Use a long, random string
LIVEKIT_API_SECRET=ThisIsMyNewVerySecureSecretKeyForLiveKit32

# ---------------------------------------------------
# --- Internal Container Ports (No need to change unless your app code changes)
# ---------------------------------------------------
GSTREAM_APP_INTERNAL_PORT=8080
LIVEKIT_INTERNAL_PORT=7880